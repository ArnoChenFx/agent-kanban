{
  "name": "agent-kanban",
  "version": "0.2.1",
  "description": "多会话 agent 共享的项目级任务看板：共享任务列表、进度、历史计划，并在 agent 崩溃后恢复上下文",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "agent-kanban": "src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "web/dist"
  ],
  "scripts": {
    "agent-kanban": "bun run src/cli.ts",
    "serve": "bun run --hot src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build && bun run gen:assets",
    "web:typecheck": "bun run --cwd web typecheck",
    "gen:assets": "bun run scripts/gen-assets.ts",
    "build:binary": "bun run web:build && bun build --compile src/cli.ts --outfile dist/agent-kanban",
    "verify:web": "bun run scripts/verify-web.ts",
    "verify:web:ui": "bun run scripts/verify-web-ui.ts",
    "verify:deps": "bun run scripts/verify-deps.ts",
    "verify:workflows": "bun run scripts/verify-workflows.ts",
    "verify:install": "bun run scripts/verify-install.ts",
    "verify:docs": "bun run scripts/verify-docs.ts",
    "verify:mcp": "bun run scripts/verify-mcp.ts",
    "verify:backup": "bun run scripts/verify-backup.ts",
    "dogfood": "bun run scripts/dogfood.ts",
    "verify:all": "bun run scripts/verify-all.ts",
    "verify:deploy": "bun run scripts/verify-deploy.ts",
    "snapshot:web": "bun run scripts/snapshot-web.ts",
    "seed:demo": "bun run scripts/seed-demo.ts"
  },
  "keywords": [
    "agent",
    "kanban",
    "task-board",
    "multi-agent",
    "crash-recovery",
    "handoff"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1"
  }
}
