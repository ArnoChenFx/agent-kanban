{
  "name": "agent-kanban",
  "version": "0.1.0",
  "description": "多会话 agent 共享的项目级任务看板：共享任务列表、进度、历史计划，并在 agent 崩溃后恢复上下文",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "kanban": "src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "web/dist"
  ],
  "scripts": {
    "kanban": "bun run src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:typecheck": "bun run --cwd web typecheck",
    "gen:assets": "bun run scripts/gen-assets.ts",
    "build:binary": "bun run web:build && bun run gen:assets && bun build --compile src/cli.ts --outfile dist/kanban",
    "verify:web": "bun run scripts/verify-web.ts",
    "verify:deploy": "bun run scripts/verify-deploy.ts",
    "snapshot:web": "bun run scripts/snapshot-web.ts"
  },
  "keywords": [
    "agent",
    "kanban",
    "task-board",
    "multi-agent",
    "crash-recovery",
    "handoff"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
